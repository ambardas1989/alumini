# ════════════════════════════════════════════════════════════
# Alumini Backend — Environment Variables
# ════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in values before starting.
# NEVER commit .env to git. It is in .gitignore.
#
# Variable descriptions match the spec (Section 22 of SPEC.md).
# ════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development

# Log level: debug | info | warn | error
# debug = development, info = production
LOG_LEVEL=info

# Port the API server listens on
PORT=3001

# Full URL of this API server (used in OAuth callback URLs)
APP_URL=http://localhost:3001

# Full URL of the web app — where GET /auth/google/callback redirects to
# after completing (or partially completing) Google sign-in.
# Render: FRONTEND_URL=https://alumtribe.com
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins
# Example: https://app.alumini.app,https://admin.alumini.app
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# ── Supabase ─────────────────────────────────────────────────
# From: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# WARNING: Service role key bypasses RLS. NEVER expose to clients.

# ── JWT ──────────────────────────────────────────────────────
# Random string, minimum 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRY=7d

# ── Google OAuth ─────────────────────────────────────────────
# From: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback

# ── LinkedIn OAuth (profile connect — name/photo only) ─────────
# From: LinkedIn Developer Portal → My Apps
# r_liteprofile/r_education (previously listed here) are retired scopes —
# no longer grantable to standard apps. Only 'openid profile email' is
# available without a LinkedIn Partner Program review, so that's all this
# app requests. See auth.service.ts's connectLinkedin() doc comment.
# No CALLBACK_URL here — the frontend builds the LinkedIn authorize URL and
# redirects itself; this backend only exchanges the resulting code
# (POST /auth/linkedin/connect), it never receives LinkedIn's redirect directly.
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ── Firebase Cloud Messaging (push notifications) ─────────────
# From: Firebase Console → Project Settings → Service accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key-here\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ── Email (Resend) ────────────────────────────────────────────
# From: Resend Dashboard → API Keys
# Free tier: 3,000 emails/month
RESEND_API_KEY=re_your_api_key_here
# Must be a verified domain in Resend
FROM_EMAIL=noreply@yourdomain.com

# ── MFA ──────────────────────────────────────────────────────
# Shown in authenticator app (e.g. Google Authenticator)
MFA_ISSUER=Alumini

# Shared secret for POST /auth/mfa/reset-dev (X-Dev-Key header) — a
# support/dev tool that wipes MFA for an account by email. Treat this
# like a credential: rotate it if it's ever exposed, don't reuse it
# anywhere else.
DEV_RESET_KEY=alumtribe-dev-reset-2026

# Twilio (for SMS OTP fallback — optional)
# From: Twilio Console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
